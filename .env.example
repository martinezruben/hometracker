# URL pública de la app (dominio oficial pendiente). Los QR se generan con este valor.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MySQL 8 (Cloud SQL, Railway, Aiven, VPS…)
DATABASE_URL=mysql://usuario:clave@host:3306/hometracker
DATABASE_SSL=false

# Sesiones y correo (login OTP)
SESSION_SECRET=
SMTP_URL=
MAIL_FROM=HomeTracker <no-reply@ejemplo.com>

# Almacenamiento de fotos/PDFs (S3 compatible: S3, R2, GCS interoperable)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Protege el endpoint del cron de recordatorios
CRON_SECRET=

# Web Push (VAPID). La privada solo en servidor.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Archivos en desarrollo (sin S3_BUCKET se guardan en este directorio)
STORAGE_DIR=.storage
